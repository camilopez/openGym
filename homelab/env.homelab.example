# openGym on the homelab. bootstrap.sh copies this to the repo root as .env.
# Everything not set here keeps the default documented in .env.example.

# Loads the Tailscale overlay on every `docker compose` command.
COMPOSE_FILE=docker-compose.yml:homelab/compose.homelab.yml

# Image tag (X.Y.Z, as published on ghcr.io). Bump by hand after reading the release notes.
OPENGYM_VERSION=1.4.1
TAILSCALE_VERSION=stable

# ── Hostname: FINAL before the first profile is created ────────────────────
# Passkeys are bound to this exact name: <TS_HOSTNAME>.<tailnet DNS name>.
TS_HOSTNAME=opengym
RP_ID=opengym.tailff2e2.ts.net
ORIGIN=https://opengym.tailff2e2.ts.net
RP_NAME=openGym
WEB_PORT=8080

# ── Accounts ───────────────────────────────────────────────────────────────
# The first profile on the empty instance becomes admin.
FIRST_USER_ADMIN=1
DEFAULT_LANG=es
# Fallback sign-in (LAN over http, or if a passkey is ever lost). Set a password in
# Settings → Account after creating the profile.
PASSWORD_LOGIN=1
# Uncomment once your own profile exists:
# INVITE_ONLY=1
# ALLOW_GUEST=0

# Private instance behind a VPN: a longer session is fine.
SESSION_DAYS=180

# VAPID_SUBJECT=mailto:you@example.com
